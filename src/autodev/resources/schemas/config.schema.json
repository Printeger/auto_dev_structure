{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodev.local/schemas/config.schema.json",
  "title": "AutoDev project configuration",
  "type": "object",
  "required": ["$schema", "schema_version", "requirements_path"],
  "properties": {
    "$schema": {"const": "https://autodev.local/schemas/config.schema.json"},
    "schema_version": {"const": 1},
    "requirements_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodev.local/schemas/command-result.schema.json",
  "title": "AutoDev command result",
  "type": "object",
  "required": ["$schema", "schema_version", "status", "exit_code", "message", "revision", "data"],
  "properties": {
    "$schema": {"const": "https://autodev.local/schemas/command-result.schema.json"},
    "schema_version": {"const": 1},
    "status": {"enum": ["SUCCESS", "INVALID", "NOT_READY", "BLOCKED", "STOPPED", "INFRA_FAILURE"]},
    "exit_code": {"enum": [0, 1, 2, 3, 4, 5]},
    "message": {"type": "string"},
    "revision": {"type": ["integer", "null"], "minimum": 0},
    "data": {"type": "object"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodev.local/schemas/manifest.schema.json",
  "title": "AutoDev project manifest",
  "type": "object",
  "required": ["$schema", "schema_version", "framework_version", "project_name", "created_at"],
  "properties": {
    "$schema": {"const": "https://autodev.local/schemas/manifest.schema.json"},
    "schema_version": {"const": 1},
    "framework_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:a[0-9]+)?$"},
    "project_name": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.+(?:Z|[+-][0-9]{2}:[0-9]{2})$"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodev.local/schemas/agent-proposal.schema.json",
  "title": "AutoDev agent proposal",
  "type": "object",
  "required": ["$schema", "schema_version", "kind", "task_id", "summary"],
  "properties": {
    "$schema": {"const": "https://autodev.local/schemas/agent-proposal.schema.json"},
    "schema_version": {"const": 1},
    "kind": {"enum": ["WORK", "REVIEW", "COMPLETE"]},
    "task_id": {"type": ["string", "null"], "pattern": "^TASK-[0-9]{3,}$"},
    "summary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

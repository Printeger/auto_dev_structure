{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodev.local/schemas/resource-manifest.schema.json",
  "title": "AutoDev packaged resource manifest",
  "type": "object",
  "required": ["$schema", "framework_version", "schemas", "templates"],
  "properties": {
    "$schema": {
      "const": "./schemas/resource-manifest.schema.json"
    },
    "framework_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:a[0-9]+)?$"
    },
    "schemas": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "migration_manifests": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "campaign_schemas": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "templates": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}

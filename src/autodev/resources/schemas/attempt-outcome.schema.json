{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodev.local/schemas/attempt-outcome.schema.json",
  "title": "AutoDev attempt outcome",
  "type": "object",
  "required": ["$schema", "schema_version", "outcome", "summary"],
  "properties": {
    "$schema": {"const": "https://autodev.local/schemas/attempt-outcome.schema.json"},
    "schema_version": {"const": 1},
    "outcome": {"enum": ["PASS", "PASS_WITH_DEBT", "REWORK", "NO_PROGRESS", "INFRA_FAILURE", "BLOCKED", "STOPPED"]},
    "summary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodev.local/schemas/action-result.schema.json",
  "title": "AutoDev untrusted role-specific Action result",
  "$defs": {
    "option": {
      "type": "object",
      "required": ["label", "description"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["id", "header", "question", "options", "isOther", "isSecret"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "header": {"type": "string", "minLength": 1, "maxLength": 12},
        "question": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/option"}},
        "isOther": {"type": "boolean"},
        "isSecret": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "objective", "requirements", "dependencies", "priority", "blocking", "risk", "quality_mode", "change_classes", "allowed_paths", "out_of_scope", "acceptance_criteria", "validation_commands", "prohibited_actions"],
      "properties": {
        "id": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"}},
        "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"}},
        "priority": {"enum": ["MUST", "SHOULD", "COULD"]},
        "blocking": {"type": "boolean"},
        "risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "quality_mode": {"enum": ["BUILD", "INTEGRATION", "HARDENING"]},
        "change_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "acceptance_criteria": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "description"],
            "properties": {
              "id": {"type": "string", "pattern": "^AC-[0-9]{3,}$"},
              "description": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "validation_commands": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["argv", "cwd", "timeout"],
            "properties": {
              "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "cwd": {"type": "string", "minLength": 1},
              "timeout": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "prohibited_actions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "debt_item": {
      "type": "object",
      "required": ["id", "source_task", "reason", "severity", "module", "fix_before", "classification"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_task": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
        "reason": {"type": "string", "minLength": 1},
        "severity": {"enum": ["LOW", "MEDIUM"]},
        "module": {"type": "string", "minLength": 1},
        "fix_before": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["outcome", "summary", "findings", "blocker", "next_action", "debt_items"],
      "properties": {
        "outcome": {"enum": ["PASS", "PASS_WITH_DEBT", "REWORK", "BLOCKED"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 20000},
        "findings": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 4000}},
        "blocker": {"type": ["string", "null"], "maxLength": 10000},
        "next_action": {"type": ["string", "null"], "maxLength": 10000},
        "debt_items": {"type": "array", "items": {"$ref": "#/$defs/debt_item"}}
      },
      "additionalProperties": false
    },
    "diagnosis": {
      "type": "object",
      "required": ["root_cause", "evidence", "recommended_action"],
      "properties": {
        "root_cause": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "recommended_action": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "answers": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    },
    "debt_data": {
      "type": "object",
      "properties": {"debt_items": {"type": "array", "items": {"$ref": "#/$defs/debt_item"}}},
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["action_id", "action_type", "canonical_revision", "outcome", "summary", "data", "findings", "blocker", "next_action"],
  "properties": {
    "action_id": {"type": "string", "pattern": "^ACTION-[0-9a-f]{32}$"},
    "action_type": {"enum": ["PLAN_PHASE", "EXECUTE_TASK", "RUN_IMMEDIATE_REVIEW", "RUN_PHASE_REVIEW", "RUN_DIAGNOSTIC"]},
    "canonical_revision": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["PASS", "PASS_WITH_DEBT", "REWORK", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 20000},
    "data": {"type": "object"},
    "findings": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 4000}},
    "blocker": {"type": ["string", "null"], "maxLength": 10000},
    "next_action": {"type": ["string", "null"], "maxLength": 10000}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "BLOCKED"}}},
      "then": {"properties": {"blocker": {"type": "string", "minLength": 1}, "next_action": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"action_type": {"const": "PLAN_PHASE"}}},
      "then": {
        "properties": {
          "outcome": {"const": "PASS"},
          "data": {
            "type": "object",
            "required": ["phase", "tasks", "questions"],
            "properties": {
              "phase": {"enum": ["SCAFFOLD", "IMPLEMENT", "COMPONENT_VERIFY", "INTEGRATE", "HARDEN"]},
              "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
              "questions": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/question"}},
              "answers": {"$ref": "#/$defs/answers"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"action_type": {"const": "EXECUTE_TASK"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/debt_data"}}}
    },
    {
      "if": {"properties": {"action_type": {"enum": ["RUN_IMMEDIATE_REVIEW", "RUN_PHASE_REVIEW"]}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "debt_items": {"type": "array", "items": {"$ref": "#/$defs/debt_item"}},
              "review": {"$ref": "#/$defs/review"}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"action_type": {"const": "RUN_DIAGNOSTIC"}}},
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {"diagnosis": {"$ref": "#/$defs/diagnosis"}},
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
